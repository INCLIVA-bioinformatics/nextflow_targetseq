/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SCOPE PARAMS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/


params {
    // Proyecto
    samplesheet        = "/mnt/zonahpc/home/bioinformatica/comun/software/targetseq_pipeline/directorio_pruebas_paneles/BRC2/samplesheet_BRC2.csv"
    study_name         = "UB000_run000_BRC2"
    outdir             = "$launchDir/BRC2_outdir"

    panel              = "BRC2"
    panel_design       = "$projectDir/panels/panel_designs/$params.panel"
    publish_dir_mode   = "symlink" // también posible: 'copy'

    // Processing parameters
    cov                = 100
    af                 = 0.02
    amplicon           = true    // BRC2: diseño amplicón
    has_umi            = false
    min_read_length    = 50
    filter_by_primer   = true    // BRC2: filtrado por primers activo
    cut_primer_error   = 0.2     // BRC2: 0.2 (vs 0.3 en TOX3/ONC4)
    cut_primer_overlap = 10
    min_trim_qual      = 30
    gatk_softclipping  = true    // BRC2: soft-clipping activado
    seq_platform       = "MiSeq"
    seq_center         = "INCLIVA"

    // Adaptadores y primers
    adapter_1          = "CTGTCTCTTATACACATCTCCGAGCCCACGAGAC"
    adapter_2          = "CTGTCTCTTATACACATCTGACGCTGCCGACGA"
    primer_set_r1      = "$params.panel_design/R1_primers.fasta"
    primer_set_r2      = "$params.panel_design/R2_primers.fasta"


    // Referencias y BBDD
    dict               = "$projectDir/databases/references/Homo_sapiens_assembly38.dict"
    fasta              = "$projectDir/databases/references/Homo_sapiens_assembly38.fasta"
    fasta_fai          = "$projectDir/databases/references/Homo_sapiens_assembly38.fasta.fai"
    bwa                = "$projectDir/databases/references/BWAIndex"
    bwamem2            = "$projectDir/databases/bwa_mem2/Homo_sapiens.GRCh38.fa"
    intervals          = "$params.panel_design/capture.bed"
    target_intervals   = "$params.panel_design/target.bed"
    gatk_indels        = "$projectDir/databases/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
    gatk_indels_tbi    = "$projectDir/databases/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi"
    dbsnp              = "$projectDir/databases/dbsnp_146.hg38.vcf.gz"
    dbsnp_tbi          = "$projectDir/databases/dbsnp_146.hg38.vcf.gz.tbi"
    inc_db             = "$projectDir/databases/inc_db.vcf"

    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
    pipeline_version = '1.0.0'
    help = false
}


// Load base.config by default for all pipelines
includeConfig "$projectDir/config/base.config"

singularity {
    enabled    = true
    autoMounts = true // Nextflow automatically mounts host paths in the executed container
    cacheDir   = "/mnt/zonahpc/home/bioinformatica/comun/software/singularity/singularity_cacheDir" // Caché de singularity
    runOptions = "-B $params.panel_design"
}
conda {
    enabled = true
    useMamba = false
    cacheDir = '/mnt/zonahpc/home/bioinformatica/comun/software/targetseq_pipeline/.nextflow/cache'
}

/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REPORTS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/



dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}

/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXTRA PARAMETERS & RESOURCES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/
workDir                     = "$launchDir/work"
params.modules_path         = "$projectDir/modules"
params.incliva_modules_path = "$projectDir/incliva_modules.nf"
params.subworkflows_path    = "$projectDir/subworkflows"

// Resources
params.max_cpus             = 15
params.max_memory           = "120.GB"
params.max_time             = "1.h"


