/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SCOPE PARAMS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/


params {
    // Proyecto
    samplesheet        = "$projectDir/test_data/samplesheet_TOX3.csv"
    study_name         = "UB000_run000_TOX3"
    outdir             = "$launchDir/TOX3_outdir"

    panel              = "TOX3"
    panel_design       = "$projectDir/panels/panel_designs/$params.panel"
    publish_dir_mode   = "symlink" // also possible: copy

    // Processing parameters
    cov                = 100
    af                 = 0.02
    amplicon           = true
    has_umi            = false // TODO - incluir toda la parte de UMIs en los workflows. ¿umitools o fgbio?
    xy_stats           = false  // estadísticas chrX/chrY (XY_stats de rutina)
    brca               = false  // estadísticas de amplicones BRCA (BRCA de rutina)
    min_read_length    = 50
    min_mapping_quality = 20
    filter_by_primer   = true
    cut_primer_error   = 0.3
    cut_primer_overlap = 10
    up_bamclip         = 19
    down_bamclip       = 19
    min_trim_qual      = 30
    gatk_softclipping  = true
    seq_platform       = "MiSeq"
    seq_center         = "INCLIVA"

    // Adaptadores y primers
    adapter_1          = "CTGTCTCTTATACACATCTCCGAGCCCACGAGAC"
    adapter_2          = "CTGTCTCTTATACACATCTGACGCTGCCGACGA"
    primer_set_r1      = "$params.panel_design/R1_primers.fasta"
    primer_set_r2      = "$params.panel_design/R2_primers.fasta"
    amplicons_bedpe    = "$params.panel_design/amplicons.pe.bed"

    // Referencias y BBDD
    dict               = "$projectDir/databases/bwa_mem2/Homo_sapiens.GRCh38.dict"
    fasta              = "$projectDir/databases/bwa_mem2/Homo_sapiens.GRCh38.fa"
    fasta_fai          = "$projectDir/databases/bwa_mem2/Homo_sapiens.GRCh38.fa.fai"
    bwa                = "$projectDir/databases/references/BWAIndex"
    bwamem2            = "$projectDir/databases/bwa_mem2/Homo_sapiens.GRCh38.fa"
    intervals          = "$params.panel_design/capture.bed"
    target_intervals   = "$params.panel_design/target.bed"
    gatk_indels        = "$projectDir/databases/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
    gatk_indels_tbi    = "$projectDir/databases/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi"
    dbsnp              = "/mnt/zonahpc/home/bioinformatica/comun/databases/dbSNP/153/All_20200219.vcf.gz"
    dbsnp_tbi          = "/mnt/zonahpc/home/bioinformatica/comun/databases/dbSNP/153/All_20200219.vcf.gz.tbi"
    inc_db             = "$projectDir/databases/inc_db.vcf"

    // Anotación (rutina.sh: annotate_variants). Sin vep_cache no se anota.
    vep_cache          = null  // directorio de la caché de VEP 110 (rutina: ensembl/v110_last, con Plugins/)
    spliceai_snv       = null  // spliceai_scores.raw.snv.hg38.vcf.gz (+ .tbi)
    spliceai_indel     = null  // spliceai_scores.raw.indel.hg38.vcf.gz (+ .tbi)
    spliceai_cutoff    = 0.2
    pick_order         = ""
    hotspots           = null  // cancer_hotspots/20180723/cancerhospots.bed.gz (+ .tbi)
    cosmic             = null  // cosmic/cosmicv91/AllMutations_COSMIC_v91.vcf.gz (+ .tbi)
    mixed_db           = null  // mixed_db/DB/mixed_db.vcf.gz (+ .tbi)
    oncokb             = null  // Oncokb_cosmic_dbsnp/dbSNP155.cosmic.oncokb.noIDs.vcf.gz (+ .tbi)

    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')
    pipeline_version = '1.0.0'
    help = false
}


// Load base.config by default for all pipelines
includeConfig "$projectDir/config/base.config"

singularity {
    enabled    = true
    autoMounts = true // Nextflow automatically mounts host paths in the executed container
    cacheDir   = "/mnt/zonahpc/home/bioinformatica/comun/software/singularity/singularity_cacheDir" // Caché de singularity
    runOptions = "-B $params.panel_design"
}
conda {
    enabled = true
    useMamba = false
    cacheDir = '/mnt/zonahpc/home/bioinformatica/comun/software/targetseq_pipeline/.nextflow/cache'
}

/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REPORTS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/



dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}

/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXTRA PARAMETERS & RESOURCES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/
workDir                     = "$launchDir/work"
params.modules_path         = "$projectDir/modules"
params.incliva_modules_path = "$projectDir/incliva_modules.nf"
params.subworkflows_path    = "$projectDir/subworkflows"

// Resources
params.max_cpus             = 15
params.max_memory           = "120.GB"
params.max_time             = "1.h"


