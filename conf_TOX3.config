/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SCOPE PARAMS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/
params {
    // Proyecto
    samplesheet        = "$projectDir/samplesheet_TOX3.csv"
    panel              = "TOX3"
    panel_design       = "/nfs/home/software/GIT_INCLIVA/targetseq/panel_designs/$params.panel"
    study_name         = "UB000_run000_TOX3"
    outdir             = "$launchDir/TOX3_outdir"
    publish_dir_mode   = "symlink" // also possible: copy

    // Processing parameters
    cov                = 100
    af                 = 0.02
    amplicon           = true
    has_umi            = false // TODO - incluir toda la parte de UMIs en los workflows. ¿umitools o fgbio?
    min_read_length    = 50
    filter_by_primer   = true
    cut_primer_error   = 0.3
    cut_primer_overlap = 10
    min_trim_qual      = 30
    gatk_softclipping  = true
    seq_platform       = "MiSeq"
    seq_center         = "INCLIVA"

    // Adaptadores y primers
    adapter_1          = "CTGTCTCTTATACACATCTCCGAGCCCACGAGAC"
    adapter_2          = "CTGTCTCTTATACACATCTGACGCTGCCGACGA"
    primer_set_r1      = "$params.panel_design/R1_primers.fasta"
    primer_set_r2      = "$params.panel_design/R2_primers.fasta"

    // Referencias y BBDD
    fasta              = "/nfs/home/references/genomes/human/GRCh38/Homo_sapiens_assembly38.fasta"
    fasta_fai          = "/nfs/home/references/genomes/human/GRCh38/Homo_sapiens_assembly38.fasta.fai"
    dict               = "/nfs/home/references/genomes/human/GRCh38/Homo_sapiens_assembly38.dict"
    bwamem2            = "/media/scratch0/nextflow_targetseq_pipeline/referencia"
    intervals          = "$params.panel_design/capture.bed"
    target_intervals   = "$params.panel_design/target.bed"
    gatk_indels        = "/nfs/home/databases/GATK/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz"
    gatk_indels_tbi    = "/nfs/home/databases/GATK/Mills_and_1000G_gold_standard.indels.hg38.vcf.gz.tbi"
    dbsnp              = "/nfs/home/databases/dbSNP/153/All_20200219.vcf.gz"
    dbsnp_tbi          = "/nfs/home/databases/dbSNP/153/All_20200219.vcf.gz.tbi"
    inc_db             = "/nfs/home/databases/INCLIVA_somatic/20200416/inc_db.vcf"
}

singularity {
    enabled    = true
    autoMounts = true // Nextflow automatically mounts host paths in the executed container
    cacheDir   = "/nfs/home/software/singularity/nf_cacheDir" // Caché de singularity
    runOptions = "-B $params.panel_design,/media/scratch0"
}

/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    SCOPE PROCESS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/
// TODO - ¿sacar las configuraciones de los diferentes módulos a otros confs? --> includeConfig
process {
    executor          = "local"
    errorStrategy     = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries        = 1

    // Process-specific resource requirements
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus          = { check_max( 1                  , 'cpus'    ) }
        memory        = { check_max( 6.GB * task.attempt, 'memory'  ) }
        time          = { check_max( 4.h  * task.attempt, 'time'    ) }
    }
    withLabel:process_low {
        cpus          = { check_max( 2     * task.attempt, 'cpus'    ) }
        memory        = { check_max( 12.GB * task.attempt, 'memory'  ) }
        time          = { check_max( 4.h   * task.attempt, 'time'    ) }
    }
    withLabel:process_medium {
        cpus          = { check_max( 6     * task.attempt, 'cpus'    ) }
        memory        = { check_max( 36.GB * task.attempt, 'memory'  ) }
        time          = { check_max( 8.h   * task.attempt, 'time'    ) }
    }
    withLabel:process_high {
        cpus          = { check_max( 12    * task.attempt, 'cpus'    ) }
        memory        = { check_max( 72.GB * task.attempt, 'memory'  ) }
        time          = { check_max( 16.h  * task.attempt, 'time'    ) }
    }
    withLabel:process_long {
        time          = { check_max( 20.h  * task.attempt, 'time'    ) }
    }
    withLabel:process_high_memory {
        memory        = { check_max( 200.GB * task.attempt, 'memory' ) }
    }

    // Extra configurations and arguments for modules

    // Quality control & preprocessing:
    withName: 'FASTQC_RAW' {
        ext.args      = '--quiet'
        publishDir    = [
            [
                path: { "${params.outdir}/reports/fastqc_raw/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*{html,zip}"
            ]
        ]
    }
    withName: 'CUTADAPT_TRIMMING' {
        ext.args      = "-a ${params.adapter_1} -A ${params.adapter_2} -m ${params.min_read_length}"
        ext.prefix    = { "${meta.id}_trimming" }
    }
    withName: 'CUTADAPT_FILTER_BY_PRIMER' {
        ext.args      = "-e ${params.cut_primer_error} -O ${params.cut_primer_overlap} --action=retain --pair-adapters --discard-untrimmed -a file:${params.primer_set_r1} -A file:${params.primer_set_r2}"
        ext.prefix    = { "${meta.id}_filter_by_primer" }
    }
    withName: 'PRINSEQ' {
        ext.args      = "-min_qual_mean ${params.min_trim_qual}"
        ext.prefix    = { "${meta.id}_preprocessed" }
    }
    withName: 'FASTQC_PREPROCESSED' {
        ext.args      = "--quiet"
        publishDir    = [
            [
                path: { "${params.outdir}/reports/fastqc_preprocessed/${meta.id}" },
                mode: params.publish_dir_mode,
                pattern: "*{html,zip}"
            ]
        ]
    }

    // Mapping & postprocessing:
    withName: 'BWAMEM2' {
        ext.args      = { "-T 0 -M -R ${meta.read_group}" }
    }
    withName: 'PICARD_CLEANSAM' {
        ext.prefix    = { "${meta.id}_processed" }
    }
    withName: 'GATK4_APPLYBQSR' {
        ext.prefix    = { "${meta.id}_recalibrated" }
    }
    withName: 'SAMTOOLS_VIEW_ONTARGET' {
        ext.file_type = "bam"
        ext.args      = { "-b -h -L ${params.intervals}" }
        ext.prefix    = { "ontarget_${meta.id}_processed" }
    }
    withName: 'BEDTOOLS_SORT' {
        ext.prefix    = { "${meta.id}_sorted" }
        ext.suffix    = "bed"
    }
    withName: 'BEDTOOLS_MERGE' {
        ext.prefix    = { "${meta.id}_merged" }
    }
    withName: 'SAMTOOLS_DEPTH' {
        ext.prefix    = { "${meta1.id}_depth" }
        ext.args      = { "-d 0 -a" }
    }
    withName: 'LOFREQ_INDELQUAL' {
        ext.args      = { "-u 20,20" }
        publishDir    = [
            mode: params.publish_dir_mode,
            path: { "${params.outdir}/mapping/" },
            saveAs: { filename -> filename.equals('versions.yml') ? '' : "${filename}" }
        ]
    }

    // Variant calling:
    withName: 'GATK4_MUTECT2' {
        ext.args      = { "--dont-use-soft-clipped-bases ${params.gatk_softclipping} --min-base-quality-score 20 --max-reads-per-alignment-start 0" }
        ext.prefix    = { "raw_mutect2_${meta.id}" }
    }
    withName: 'GATK4_FILTERMUTECTCALLS' {
        ext.prefix    = { "filtered_mutect2_${meta.id}" }
    }
    withName: 'BCFTOOLS_NORM_MUTECT2' {
        ext.args      = { "-m-any -Oz -cw" }
        ext.prefix    = { "normalized_mutect2_${meta.id}" }
    }
    withName: 'TABIX_BGZIPTABIX' {
        ext.prefix    = { "selected_mutect2_${meta.id}" }
    }
    withName: 'BCFTOOLS_SORT_MUTECT2' {
        ext.args      = { "-Oz" }
        ext.prefix    = { "${meta.id}.mutect2" }
    }
    withName: 'LOFREQ_CALLPARALLEL' {
        ext.args      = { "--call-indels" }
        ext.prefix    = { "raw_lofreq_${meta.id}" }
    }
    withName: 'BCFTOOLS_NORM_LOFREQ' {
        ext.args      = { "-m-any -Oz -cw" }
        ext.prefix    = { "normalized_lofreq_${meta.id}" }
    }
    withName: 'BCFTOOLS_SORT_LOFREQ' {
        ext.args      = { "-Oz" }
        ext.prefix    = { "${meta.id}.lofreq" }
    }
    withName: 'BCFTOOLS_CONCAT' {
        ext.args      = { "-a -D -Oz" }
    }
}

/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    REPORTS
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/
def trace_timestamp = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

dag {
    enabled = true
    file    = "${params.outdir}/execution_reports/pipeline_dag_${trace_timestamp}.png"
}

report {
    enabled = true
    file    = "${params.outdir}/execution_reports/report_${trace_timestamp}.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/execution_reports/timeline_${trace_timestamp}.html"
}

trace {
    enabled = true
    file    = "${params.outdir}/execution_reports/trace_${trace_timestamp}.tsv"
}

/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    EXTRA PARAMETERS & RESOURCES
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/
workDir                     = "/media/scratch0/nextflow_targetseq_pipeline/work"
params.modules_path         = "/media/scratch0/nextflow_targetseq_pipeline/modules/modules/nf-core"
params.incliva_modules_path = "$projectDir/incliva_modules.nf"
params.subworkflows_path    = "/media/scratch0/nextflow_targetseq_pipeline/nextflow/targetseq_pipeline/subworkflows"

// Resources
params.max_cpus             = 15
params.max_memory           = "120.GB"
params.max_time             = "1.h"

// Function to ensure that resource requirements don't go beyond a user-defined maximum limit
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}
