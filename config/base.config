process {
    executor = 'slurm'

    /*
     * Límites globales: Nextflow recorta automáticamente solicitudes
     * superiores a estos valores.
     */
    resourceLimits = [
        cpus:   15,
        memory: 120.GB,
        time:   24.h
    ]

    /*
     * Recursos por defecto para cualquier proceso sin label específico.
     */
    cpus   = { 2    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 8.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    /*
     * Recursos por label.
     */
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }

    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    withLabel: process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    withLabel: process_light {
        cpus   = { 1                   }
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    withLabel: process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    withLabel: process_long {
        time = { 20.h * task.attempt }
    }

    withLabel: process_high_memory {
        memory = { 200.GB * task.attempt }
    }

    /*
     * QC y preprocesamiento.
     */
    // FastQC sólo analiza 2 ficheros por muestra (R1 y R2), así que no usa más de 2 hilos, y su pico de memoria es
    // de ~2 GB: process_medium (6 CPUs, 36 GB) reservaba de más en Slurm
    withName: 'FASTQC_RAW|FASTQC_PREPROCESSED' {
        cpus   = { 2                   }
        memory = { 8.GB * task.attempt }
    }

    withName: 'FASTQC_RAW' {
        ext.args = '--nogroup --quiet'
        publishDir = [
            [
                path: "${params.outdir}/QC/rawdata",
                mode: params.publish_dir_mode,
                pattern: '*{html,zip}'
            ]
        ]
    }

    withName: 'CUTADAPT_TRIMMING' {
        ext.args   = "-a ${params.adapter_1} -A ${params.adapter_2} -m ${params.min_read_length}"
        ext.prefix = { "${meta.id}_trimming" }
    }

    withName: 'CUTADAPT_FILTER_BY_PRIMER' {
        ext.args   = "-e ${params.cut_primer_error} -O ${params.cut_primer_overlap} --action=retain --pair-adapters -m ${params.min_read_length} --discard-untrimmed -a file:${params.primer_set_r1} -A file:${params.primer_set_r2}"
        ext.prefix = { "${meta.id}_filter_by_primer" }
    }

    withName: 'PRINSEQ' {
        ext.args   = "-min_qual_mean ${params.min_trim_qual}"
        ext.prefix = { "${meta.id}_preprocessed" }
    }

    withName: 'FASTQC_PREPROCESSED' {
        ext.args   = '--nogroup --quiet'
        ext.prefix = { "filtered_${meta.id}" } // como rutina.sh: filtered_<muestra>_{1,2}_fastqc
        publishDir = [
            [
                path: "${params.outdir}/QC/rawdata",
                mode: params.publish_dir_mode,
                pattern: '*{html,zip}'
            ]
        ]
    }

    /*
     * Mapeado y postprocesamiento.
     */
    withName: 'BWAMEM2' {
        cpus = 4
        memory = '8 GB'
        time = '6 h'
        // -K fija el tamaño de lote (= 10M bases x 16 hilos de rutina.sh) para que el resultado no dependa de cpus
        ext.args  = { "-T 0 -M -K 160000000 -R ${meta.read_group}" }
        ext.args3 = { "-q ${params.min_mapping_quality}" }
    }

    withName: 'PICARD_MARKDUPLICATES' {
        ext.args   = 'REMOVE_DUPLICATES=True'
        ext.prefix = { "${meta.id}_dedup" }
    }

    withName: 'BAMCLIPPER' {
        ext.args   = { "-u ${params.up_bamclip} -d ${params.down_bamclip}" }
        ext.prefix = { "${meta.id}_primerclipped" }
    }

    // Mismas versiones que rutina.sh (GATK 4.4.0.0, LoFreq 2.1.3.1)
    // Con GATK 4.6 FilterMutectCalls asigna etiquetas distintas a algunas variantes (p.ej. clustered_events)
    withName: 'GATK4_BASERECALIBRATOR|GATK4_APPLYBQSR|GATK4_MUTECT2|GATK4_FILTERMUTECTCALLS' {
        container = 'quay.io/biocontainers/gatk4:4.4.0.0--py36hdfd78af_0'
    }

    withName: 'PICARD_CLEANSAM' {
        ext.prefix = { "${meta.id}_processed" }
    }


    withName: 'GATK4_APPLYBQSR' {
        ext.prefix = { "${meta.id}_recalibrated" }
        ext.suffix = 'bam'

    }
    withName: 'SAMTOOLS_VIEW_ONTARGET' {
        ext.file_type = 'bam'
        ext.args      = { "-b -h -L ${params.intervals}" }
        ext.prefix    = { "ontarget_${meta.id}_processed" }
    }

    withName: 'BEDTOOLS_SORT' {
        ext.prefix = { "${meta.id}_sorted" }
        ext.suffix = 'bed'
    }

    withName: 'BEDTOOLS_MERGE' {
        ext.prefix = { "${meta.id}_merged" }
    }

    withName: 'SAMTOOLS_DEPTH' {
        ext.prefix = { "${meta.id}_depth" }
        ext.args   = { '-d 0 -a' }
    }

    withName: 'LOFREQ_INDELQUAL' {
        container = 'quay.io/biocontainers/lofreq:2.1.3.1--py36_0'
        ext.args = { '-u 20,20' }
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: "${params.outdir}/mapping",
                saveAs: { filename -> filename == 'versions.yml' ? null : filename }
            ]
        ]
    }
    withName: 'INDEX_POSTPROCESSED_BAM' {
        publishDir = [
        mode: params.publish_dir_mode,
        path: "${params.outdir}/mapping",
        saveAs: { filename ->
            filename.endsWith('.bai') || filename == 'versions.yml'
                ? filename
                : null
        }
    ]  
    }
    withName: 'BCFTOOLS_SORT_FINAL' {
        publishDir = [
        mode: params.publish_dir_mode,
        path: "${params.outdir}/variant_calling",
        saveAs: { filename -> filename.endsWith('.vcf.gz') ? filename : null }
            ]
    }
    withName: 'GET_COVERED_BED' {
        publishDir = [
        mode: params.publish_dir_mode,
        path: "${params.outdir}/QC/mapping",
        saveAs: { filename ->
            filename.endsWith('.bed') || filename == 'versions.yml'
                ? filename
                : null}
             ]   
    }
    /*
     * Variant calling.
     */
    withName: 'GATK4_MUTECT2' {
        ext.args   = { "--dont-use-soft-clipped-bases ${params.gatk_softclipping} --min-base-quality-score 20 --max-reads-per-alignment-start 0 --genotype-germline-sites"}
        ext.prefix = { "raw_mutect2_${meta.id}" }
    }

    withName: 'GATK4_FILTERMUTECTCALLS' {
        ext.args   = { "--max-events-in-region 4"}
        ext.prefix = { "filtered_mutect2_${meta.id}" }
    }

    withName: 'BCFTOOLS_NORM_MUTECT2' {
        ext.args   = { '-m-any -a --atom-overlaps . -Oz -cw' } // -a como rutina.sh: separa MNPs en SNPs
        ext.prefix = { "normalized_mutect2_${meta.id}" }
    }

    /*
     * Ambos alias TABIX_BGZIPTABIX comparten este selector simple.
     */
    withName: 'TABIX_BGZIPTABIX.*' {
        ext.prefix = { "selected_${meta.id}" }
    }

    withName: 'INC_RESCUE_VARIANTS' {
        ext.args   = { 'haplotype' } // etiquetas de FilterMutectCalls a rescatar (separadas por comas), como rutina.sh
    }

    withName: 'BCFTOOLS_SORT_MUTECT2' {
        ext.args   = { '-Oz' }
        ext.prefix = { "${meta.id}.mutect2" }
    }

    withName: 'LOFREQ_CALLPARALLEL' {
        ext.args   = { '--call-indels' }
        ext.prefix = { "raw_lofreq_${meta.id}" }
    }

    withName: 'BCFTOOLS_NORM_LOFREQ' {
        ext.args   = { '-m-any -a --atom-overlaps . -Oz -cw' } // -a como rutina.sh: separa MNPs en SNPs
        ext.prefix = { "normalized_lofreq_${meta.id}" }
    }

    withName: 'BCFTOOLS_SORT_LOFREQ' {
        ext.args   = { '-Oz' }
        ext.prefix = { "${meta.id}.lofreq" }
    }

    withName: 'BCFTOOLS_CONCAT' {
        ext.args   = { '-a -D -Oz' }
        ext.prefix = { "concat_${meta.id}" }
    }

    /*
     * Amplicones (rutina.sh: inc_tag_reliable). Los TABIX_BGZIPTABIX_TAG_* van después de 'TABIX_BGZIPTABIX.*' para
     * sobrescribir su prefix (si no, los dos vcf que entran en BCFTOOLS_CONCAT se llamarían igual).
     */
    withName: 'INC_TAG_RELIABLE_MUTECT2' {
        ext.args   = { 'Low_confidence' }
    }

    withName: 'INC_TAG_RELIABLE_LOFREQ' {
        ext.args   = { 'High_confidence' }
    }

    withName: 'TABIX_BGZIPTABIX_TAG_MUTECT2' {
        ext.prefix = { "${meta.id}.mutect2.tagged" }
    }

    withName: 'TABIX_BGZIPTABIX_TAG_LOFREQ' {
        ext.prefix = { "${meta.id}.lofreq.tagged" }
    }

    // VCF final por muestra (se publica en variant_calling)
    withName: 'BCFTOOLS_SORT_FINAL' {
        ext.args   = { '-Oz --write-index=tbi' }
        ext.prefix = { "${meta.id}" }
    }

    // VCF multi-muestra (rutina.sh: bcftools merge -m none)
    withName: 'INC_BCFTOOLS_MERGE' {
        ext.args   = { '-m none -Oz' }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            mode: params.publish_dir_mode,
            path: "${params.outdir}/variant_calling",
            saveAs: { filename -> filename.endsWith('.vcf.gz') ? filename : null }
        ]
    }

    /*
     * Anotación (rutina.sh: annotate_variants). Nombres intermedios como en rutina (<corrida>_annotated_*.vcf).
     */
    withName: 'INC_VEP' {
        ext.args = { params.pick_order ?: '' } // rutina.sh: --canonical ${pick_order}
    }

    withName: 'SNPSIFT_COSMIC' {
        ext.suffix = 'annotated_uniq_h_c'
    }

    withName: 'SNPSIFT_MIXED' {
        ext.suffix = 'annotated_mixed'
    }

    withName: 'SNPSIFT_INC_DB' {
        ext.suffix = 'annotated_db'
    }

    withName: 'SNPSIFT_ONCOKB' {
        ext.args   = '-info hSL,Oncogenic,VARIANT_IN_ONCOKB,Treatment'
        ext.suffix = 'oncokb'
    }

    // Va después de 'TABIX_BGZIPTABIX.*' para sobrescribir su prefix
    withName: 'TABIX_BGZIPTABIX_ANNOTATED' {
        ext.prefix = { "${meta.id}_annotated_tmp1" }
    }

    withName: 'VCFLIB_VCFUNIQ_ANNOTATED' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: "${params.outdir}/variant_calling",
            saveAs: { filename -> filename.endsWith('.uniq.vcf.gz') ? "${params.study_name}_annotated.vcf.gz" : null }
        ]
    }

    withName: 'INC_AA_3TO1' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: "${params.outdir}/variant_calling",
            saveAs: { filename -> filename.endsWith('_annotated.csv') ? filename : null }
        ]
    }

    withName: 'INC_SPLIT_ANNOTATED_CSV' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: "${params.outdir}/variant_calling",
            saveAs: { filename -> filename.endsWith('.csv') ? new File(filename).name : null }
        ]
    }

    withName: 'INC_SAMPLES_CONTAMINATION' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: "${params.outdir}/QC/mapping",
            saveAs: { filename -> filename.endsWith('.csv') ? new File(filename).name : null }
        ]
    }

    /*
     * Estadísticas (mismas salidas que rutina.sh en analysis/QC/mapping).
     */
    withName: 'SAMTOOLS_VIEW_ONTARGET_SORTED' {
        ext.args   = { "-b -h -L ${params.intervals}" }
        ext.prefix = { "ontarget_${meta.id}_sorted" }
    }

    withName: 'PICARD_CASM_SORTED' {
        ext.prefix = { "${meta.id}_sorted" }
    }

    withName: 'PICARD_CASM_ONTARGET_SORTED' {
        ext.prefix = { "ontarget_${meta.id}_sorted" }
    }

    withName: 'PICARD_CASM_ONTARGET_PROCESSED' {
        ext.prefix = { "ontarget_${meta.id}_processed" }
    }

    withName: 'GLOBAL_MAPPING_STATS|STATS_BY_GENE|NON_COVERED_REGIONS|STATS_BY_AMPLICON|AF_MERGE_PLOT' {
        publishDir = [
            mode: params.publish_dir_mode,
            path: "${params.outdir}/QC/mapping",
            saveAs: { filename ->
                filename == 'versions.yml' || filename.endsWith('_mapping_stats.csv') || filename.endsWith('_idxstats')
                    ? null
                    : new File(filename).name
            }
        ]
    }
}