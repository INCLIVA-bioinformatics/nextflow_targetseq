process {
    executor = 'slurm'

    /*
     * Límites globales: Nextflow recorta automáticamente solicitudes
     * superiores a estos valores.
     */
    resourceLimits = [
        cpus:   15,
        memory: 120.GB,
        time:   24.h
    ]

    /*
     * Recursos por defecto para cualquier proceso sin label específico.
     */
    cpus   = { 2    * task.attempt }
    memory = { 6.GB * task.attempt }
    time   = { 8.h  * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    /*
     * Recursos por label.
     */
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }

    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    withLabel: process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    withLabel: process_light {
        cpus   = { 1                   }
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    withLabel: process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withLabel: process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    withLabel: process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    withLabel: process_long {
        time = { 20.h * task.attempt }
    }

    withLabel: process_high_memory {
        memory = { 200.GB * task.attempt }
    }

    /*
     * QC y preprocesamiento.
     */
    withName: 'FASTQC_RAW' {
        ext.args = '--quiet'
    }

    withName: 'CUTADAPT_TRIMMING' {
        ext.args   = "-a ${params.adapter_1} -A ${params.adapter_2} -m ${params.min_read_length}"
        ext.prefix = { "${meta.id}_trimming" }
    }

    withName: 'CUTADAPT_FILTER_BY_PRIMER' {
        ext.args   = "-e ${params.cut_primer_error} -O ${params.cut_primer_overlap} --action=retain --pair-adapters --discard-untrimmed -a file:${params.primer_set_r1} -A file:${params.primer_set_r2}"
        ext.prefix = { "${meta.id}_filter_by_primer" }
    }

    withName: 'PRINSEQ' {
        ext.args   = "-min_qual_mean ${params.min_trim_qual}"
        ext.prefix = { "${meta.id}_preprocessed" }
    }

    withName: 'FASTQC_PREPROCESSED' {
        ext.args = '--quiet'
        publishDir = [
            [
                path: "${params.outdir}/QC/rawdata",
                mode: params.publish_dir_mode,
                pattern: '*{html,zip}'
            ]
        ]
    }

    /*
     * Mapeado y postprocesamiento.
     */
    withName: 'BWAMEM2' {
        cpus = 12
        memory = '36 GB'
        time = '24 h'
        ext.args = { "-T 0 -M -R ${meta.read_group}" }
        ext.args2 = '-m 2G'
    }

    withName: 'PICARD_CLEANSAM' {
        ext.prefix = { "${meta.id}_processed" }
    }

    withName: 'GATK4_APPLYBQSR' {
        ext.prefix = { "${meta.id}_recalibrated" }
        ext.suffix = 'bam'

    }

    withName: 'SAMTOOLS_VIEW_ONTARGET' {
        ext.file_type = 'bam'
        ext.args      = { "-b -h -L ${params.intervals}" }
        ext.prefix    = { "ontarget_${meta.id}_processed" }
    }

    withName: 'BEDTOOLS_SORT' {
        ext.prefix = { "${meta.id}_sorted" }
        ext.suffix = 'bed'
    }

    withName: 'BEDTOOLS_MERGE' {
        ext.prefix = { "${meta.id}_merged" }
    }

    withName: 'SAMTOOLS_DEPTH' {
        ext.prefix = { "${meta.id}_depth" }
        ext.args   = { '-d 0 -a' }
    }

    withName: 'LOFREQ_INDELQUAL' {
        ext.args = { '-u 20,20' }
        publishDir = [
            [
                mode: params.publish_dir_mode,
                path: "${params.outdir}/mapping",
                saveAs: { filename -> filename == 'versions.yml' ? null : filename }
            ]
        ]
    }
    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
        mode: params.publish_dir_mode,
        path: "${params.outdir}/mapping",
        saveAs: { filename ->
            filename.endsWith('.vcf') || filename == 'versions.yml'
                ? filename
                : null
        }
    ]  
    }
    withName: 'BCFTOOLS_CONCAT' {
        publishDir = [
        mode: params.publish_dir_mode,
        path: "${params.outdir}/variant_calling",
        saveAs: { filename -> filename == 'versions.yml' ? null : filename }
            ]
    }

    /*
     * Variant calling.
     */
    withName: 'GATK4_MUTECT2' {
        ext.args   = { "--dont-use-soft-clipped-bases ${params.gatk_softclipping} --min-base-quality-score 20 --max-reads-per-alignment-start 0" }
        ext.prefix = { "raw_mutect2_${meta.id}" }
    }

    withName: 'GATK4_FILTERMUTECTCALLS' {
        ext.prefix = { "filtered_mutect2_${meta.id}" }
    }

    withName: 'BCFTOOLS_NORM_MUTECT2' {
        ext.args   = { '-m-any -Oz -cw' }
        ext.prefix = { "normalized_mutect2_${meta.id}" }
    }

    /*
     * Ambos aliases TABIX_BGZIPTABIX comparten este selector simple.
     */
    withName: 'TABIX_BGZIPTABIX.*' {
        ext.prefix = { "selected_${meta.id}" }
    }

    withName: 'BCFTOOLS_SORT_MUTECT2' {
        ext.args   = { '-Oz' }
        ext.prefix = { "${meta.id}.mutect2" }
    }

    withName: 'LOFREQ_CALLPARALLEL' {
        ext.args   = { '--call-indels' }
        ext.prefix = { "raw_lofreq_${meta.id}" }
    }

    withName: 'BCFTOOLS_NORM_LOFREQ' {
        ext.args   = { '-m-any -Oz -cw' }
        ext.prefix = { "normalized_lofreq_${meta.id}" }
    }

    withName: 'BCFTOOLS_SORT_LOFREQ' {
        ext.args   = { '-Oz' }
        ext.prefix = { "${meta.id}.lofreq" }
    }

    withName: 'BCFTOOLS_CONCAT' {
        ext.args = { '-a -D -Oz' }
    }
}